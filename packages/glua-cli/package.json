{
  "name": "glua-cli",
  "version": "0.6.0",
  "description": "Lint and format Garry's Mod Lua from the command line, using the same analysis as the GLua language server.",
  "license": "MIT",
  "homepage": "https://glua.bluejutzu.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bluejutzu/glua-lsp.git",
    "directory": "packages/glua-cli"
  },
  "keywords": [
    "glua",
    "garrysmod",
    "gmod",
    "lua",
    "linter",
    "formatter"
  ],
  "type": "commonjs",
  "bin": {
    "glua": "./dist/glua.js",
    "glua-lsp": "./dist/glua-lsp.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node --test --test-reporter=../glua-core/test/reporter.mjs test/*.test.mjs",
    "prepublishOnly": "node esbuild.mjs --production"
  },
  "//": "glua-core is a private, unpublished workspace package esbuild bundles at build time — it's a devDependency on purpose, so publishing never tries to resolve it as a runtime dependency. Installing this from npm still pulls nothing else in.",
  "devDependencies": {
    "@types/node": "^24.13.3",
    "commander": "^13.1.0",
    "esbuild": "^0.25.0",
    "glua-core": "workspace:*",
    "typescript": "^7.0.2",
    "vscode-languageserver-types": "^3.18.0",
    "vscode-uri": "^3.1.0"
  }
}
