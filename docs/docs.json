{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "GLua Language Server",
  "colors": {
    "primary": "#D97757",
    "light": "#E89B80",
    "dark": "#A85C42"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "system"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get Started",
            "pages": ["index", "installation", "quickstart"]
          },
          {
            "group": "Features",
            "pages": [
              "features/intellisense",
              "features/typing-your-code",
              "features/realms",
              "features/net-messages",
              "features/hooks"
            ]
          },
          {
            "group": "Formatting",
            "pages": ["features/formatter"]
          },
          {
            "group": "Configuration",
            "pages": [
              "configuration/overview",
              "configuration/config-files",
              "configuration/suppressions"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "Reference",
            "pages": [
              "reference/rules",
              "reference/annotations",
              "reference/commands",
              "reference/cli",
              "reference/performance"
            ]
          }
        ]
      },
      {
        "tab": "Contributing",
        "groups": [
          {
            "group": "Internals",
            "pages": ["contributing/architecture", "contributing/development"]
          },
          {
            "group": "Maintaining",
            "pages": ["contributing/publishing"]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/Bluejutzu/glua-lsp"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Bluejutzu/glua-lsp"
    }
  },
  "search": {
    "prompt": "Search the GLua docs"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "download-pdf"
    ],
    "display": "header"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "catppuccin-latte",
        "dark": "catppuccin-macchiato"
      }
    }
  },
  "fonts": {
    "heading": {
      "family": "Poppins",
      "weight": 600
    },
    "body": {
      "family": "Inter"
    }
  }
}
