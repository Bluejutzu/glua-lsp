{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "GLua Language Server",
  "colors": {
    "primary": "#D97757",
    "light": "#E89B80",
    "dark": "#A85C42"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "system"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": ["index", "installation", "quickstart"]
          },
          {
            "group": "Features",
            "pages": [
              "features/intellisense",
              "features/realms",
              "features/net-messages",
              "features/hooks",
              "features/formatter"
            ]
          },
          {
            "group": "Configuration",
            "pages": [
              "configuration/overview",
              "configuration/config-files",
              "configuration/suppressions"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/rules",
              "reference/annotations",
              "reference/commands",
              "reference/performance"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/Bluejutzu/glua-lsp"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Bluejutzu/glua-lsp"
    }
  },
  "search": {
    "prompt": "Search the GLua docs"
  }
}
