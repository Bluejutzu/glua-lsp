{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "GLua for Garry's Mod",
  "colors": {
    "primary": "#D97757",
    "light": "#E89B80",
    "dark": "#A85C42"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "appearance": {
    "default": "system"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get Started",
            "pages": ["index", "installation", "quickstart"]
          },
          {
            "group": "Features",
            "pages": [
              "features/intellisense",
              "features/typing-your-code",
              "features/realms",
              "features/net-messages",
              "features/hooks",
              "features/assets",
              "features/hot-paths",
              "features/report"
            ]
          },
          {
            "group": "Formatting",
            "pages": ["features/formatter"]
          },
          {
            "group": "Configuration",
            "pages": [
              "configuration/overview",
              "configuration/config-files",
              "configuration/frameworks",
              "configuration/suppressions"
            ]
          },
          {
            "group": "Changelog",
            "pages": ["changelog", "cli-changelog"]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "Language",
            "pages": ["reference/rules", "reference/annotations"]
          },
          {
            "group": "Config Schemas",
            "pages": [
              "reference/glua-schema",
              "reference/gluafmtrc-schema",
              "reference/baseline-schema"
            ]
          },
          {
            "group": "Tools",
            "pages": [
              "reference/commands",
              "reference/cli",
              "reference/editors",
              "reference/performance"
            ]
          }
        ]
      },
      {
        "tab": "Contributing",
        "groups": [
          {
            "group": "Internals",
            "pages": ["contributing/architecture", "contributing/development"]
          },
          {
            "group": "Maintaining",
            "pages": ["contributing/publishing"]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "icon": "github",
        "href": "https://github.com/Bluejutzu/glua-lsp"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Bluejutzu/glua-lsp"
    }
  },
  "search": {
    "prompt": "Search the GLua docs"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "download-pdf"
    ],
    "display": "header"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "fonts": {
    "heading": {
      "family": "Poppins",
      "weight": 600
    },
    "body": {
      "family": "Inter"
    }
  }
}
