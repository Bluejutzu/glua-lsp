{
  "name": "glua-lsp-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "Language server, VS Code extension and documentation for Garry's Mod Lua.",
  "license": "MIT",
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "build": "pnpm -r --sequential build",
    "watch": "pnpm --filter glua watch",
    "test": "pnpm -r --sequential test",
    "typecheck": "pnpm -r --sequential typecheck",
    "bench": "pnpm --filter glua bench",
    "generate-api": "pnpm --filter glua generate-api",
    "package": "pnpm --filter glua package",
    "release": "node scripts/release.mjs",
    "generate-icon": "node scripts/generate-icon.mjs",
    "docs:changelog": "node scripts/generate-changelog-docs.mjs",
    "glua": "node packages/glua-cli/dist/glua.js",
    "lint:example": "node packages/glua-cli/dist/glua.js lint packages/glua-lsp/examples/my_addon --root packages/glua-lsp/examples/my_addon",
    "docs": "cd docs && mint dev --port 3333",
    "docs:check": "cd docs && mint broken-links"
  },
  "devDependencies": {
    "mint": "^4.2.818"
  }
}
