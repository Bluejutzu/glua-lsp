{
  "name": "glua-lsp-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "Language server, VS Code extension and documentation for Garry's Mod Lua.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm --filter glua-lsp build",
    "watch": "pnpm --filter glua-lsp watch",
    "test": "pnpm --filter glua-lsp test",
    "typecheck": "pnpm --filter glua-lsp typecheck",
    "bench": "pnpm --filter glua-lsp bench",
    "generate-api": "pnpm --filter glua-lsp generate-api",
    "package": "pnpm --filter glua-lsp package",
    "docs": "cd docs && mint dev --port 3333",
    "docs:check": "cd docs && mint broken-links"
  },
  "devDependencies": {
    "mint": "^4.2.818"
  }
}
